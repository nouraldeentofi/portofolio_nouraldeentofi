# The pages.dev address serves a full copy of the site. This keeps the copy
# out of search results. The rule names that host, so it can never reach the
# real domain: scripts/validate.mjs fails on any X-Robots-Tag rule that is not
# scoped to a pages.dev host.
https://nouraldeentofi.pages.dev/*
  X-Robots-Tag: noindex

/api/*
  Access-Control-Allow-Origin: *
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600

/llms.txt
  Access-Control-Allow-Origin: *
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Access-Control-Allow-Origin: *
  Content-Type: text/plain; charset=utf-8

/assets/css/*
  Cache-Control: public, max-age=604800

# Scripts import one another by bare address (main.js imports ./motion.js),
# so a fingerprint on the first one cannot refresh the rest. They are small:
# the browser asks each time and is told "not modified".
#
# This rule and the one for pictures below reach a browser only while the
# Cloudflare zone is set to Caching, Configuration, Browser Cache TTL:
# Respect Existing Headers. With any other value Cloudflare replaces this
# header with its own time. README.md (Deploying) has the two checks.
/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

# A picture has one address, with no fingerprint, so that the page, og:image
# and the structured data all name the same one. A re-shot screenshot keeps
# its name, so the browser checks for a newer one instead of trusting its copy.
# Depends on the same Cloudflare setting as the rule for scripts above.
/assets/img/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/cv/*
  Cache-Control: public, max-age=0, must-revalidate

# The CV is linked with a ?v= fingerprint, so every new version looks like a
# new address to a search engine. This names the one address it keeps.
# scripts/validate.mjs checks it against profile.site and profile.cv in data/.
/assets/cv/Nour_Aldeen_Tofi.pdf
  Link: <https://nouraldeentofi.com/assets/cv/Nour_Aldeen_Tofi.pdf>; rel="canonical"

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
